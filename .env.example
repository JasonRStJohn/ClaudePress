# ClaudePress environment variables
# Copy to .env in the consuming site repo.

# Public URL the browser uses to reach PocketBase (file downloads, client fetches).
# In local dev: http://localhost:8090
# In production: https://cms.your-domain.com
NUXT_PUBLIC_PB_URL=http://localhost:8090

# Display name for the site (used in SEO defaults).
NUXT_PUBLIC_SITE_NAME=ClaudePress Site

# Offer the self-service password-reset flow (forgot/reset pages + login link).
# Leave unset/false until this site has SMTP configured in PocketBase AND the
# reset email template retargeted (see README "Account & password management").
# Change-password does not depend on this. Read at runtime — no rebuild to flip.
NUXT_PUBLIC_PASSWORD_RESET_ENABLED=false

# Shared secret for the ISR revalidate webhook.
# Must match between the Nuxt frontend and the PocketBase hook container.
REVALIDATE_SECRET=change-me-to-a-long-random-string
